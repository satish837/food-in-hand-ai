# Food in Hand - Environment Variables
# Copy this file to .env.local and add your API keys

# Option 1: Replicate API (Recommended)
# Get your token from: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Option 2: Fal.ai API (Alternative)
# Get your key from: https://fal.ai/dashboard
FAL_KEY=b8e53739-8240-434b-8b5a-ce8e3e6c208f:2abed9cf418b3c28375dbfc0cab8d286

# Note: You only need one of the above API keys
# The app will automatically use whichever one is available
